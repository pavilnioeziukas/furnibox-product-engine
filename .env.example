# Naujiems klientų Product Engine diegimams naudokite neutralius pavadinimus.
# Seni FURNIBOX_* kintamieji pereinamuoju laikotarpiu vis dar palaikomi.
PRODUCT_ENGINE_APP_NAME=Furnibox Product Engine
PRODUCT_ENGINE_BRAND=Furnibox
PRODUCT_ENGINE_BRAND_MARK=F
PRODUCT_ENGINE_HERO_EYEBROW=Production · tik skaitymas ir failų generavimas
PRODUCT_ENGINE_HERO_TITLE=Produktų ir BOM paruošimas vienoje vietoje
PRODUCT_ENGINE_HERO_DESCRIPTION=Įkelkite aktualų Reform BOM, paleiskite patikras ir atsisiųskite paruoštus Odoo importo failus.
PRODUCT_ENGINE_ENABLED_ACTIONS=
PRODUCT_ENGINE_ACTION_MODULES=
PRODUCT_ENGINE_SHOW_BOM_WORKSPACE=true
PRODUCT_ENGINE_SHOW_PRICING_NAV=true

# TOC Decision Support patvari saugykla ir pirmoji individuali paskyra.
# Railway prijungtas PostgreSQL paprastai pats pateikia DATABASE_URL.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
PRODUCT_ENGINE_INITIAL_ADMIN_USERNAME=admin
PRODUCT_ENGINE_INITIAL_ADMIN_PASSWORD=PAKEISKITE_STIPRIU_SLAPTAZODZIU
